	(lib_symbols)
	(text "RX: PIN T/R -> 7-pole LPF -> elliptic HPF -> BFR92P LNA -> J310 mixer (LO 108) -> 37.4 MHz 4-crystal ladder -> BFR92P -> MC3361 (38.4 MHz) -> 1 MHz -> LM386"
		(exclude_from_sim no)
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "2ae2e2d4-ad93-4e69-b7ff-eae0b1d75f4d")
	)
	(text "WK-3  -  fully analog 2 m NBFM PTT walkie-talkie (no MCU, no PLL, no firmware, no alignment)"
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2f7f689c-a8e8-4b1b-842a-e1ba83077f40")
	)
	(text "Nothing to trim: no trimmer caps, pots or adjustable coils. Simulation benches for KiCad's simulator in sim/. Amateur licence required to transmit."
		(exclude_from_sim no)
		(at 25.4 198.12 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "7f7a3992-8df0-4676-b8d2-edd18aaaeb34")
	)
	(text "Channel: 145.400 MHz simplex, 12.5 kHz NBFM; stock crystals only: 54.000 / 37.400 / 38.400 MHz (all LCSC)"
		(exclude_from_sim no)
		(at 25.4 167.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "a110944c-abb2-4ebb-bd40-fbf3d24835a7")
	)
	(text "Supply: 2S Li-ion 6.0-8.4 V; LP2985 5 V; PTT switches TX5 / RX5 rails with P-FETs"
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "cd1668c6-2779-4a33-8946-886a9d8fa850")
	)
	(text "TX: 54 MHz VXO (FM on 1SV305) x2 = 108 MHz + 37.4 MHz -> MC1496 + ETC1-1-13 baluns -> HPF / LPF / BFR92P x2 -> 2SC3357 -> RFM01U7P (fixed bias), ~1 W"
		(exclude_from_sim no)
		(at 25.4 175.26 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "ce5d68f4-366e-4be7-8b9d-390dabbba420")
	)
