		(title "2.5GPcieV1 - RTL8125BG 2.5GbE PCIe x1 card")
		(date "2026-10-16")
		(rev "2")
		(company "2.5GPcieV1")
		(comment 1 "Overview")
	)
	(lib_symbols)
	(text "- 2 LEDs in the RJ45: green = LED1, yellow = LED2. Their function is set by the driver (default: link/activity)."
		(exclude_from_sim no)
		(at 30.48 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "134a907b-d856-57a6-bf10-a86aab60cc5c")
	)
	(text "- No EEPROM or SPI flash. The MAC comes from the chip's eFuse if programmed, otherwise the driver assigns one."
		(exclude_from_sim no)
		(at 30.48 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2243150e-4d7b-586a-b71b-9e1776ee87ba")
	)
	(text "- Plugs into any PCIe x1 (or wider) slot; the OS driver (r8125 / r8169 / Windows) configures the chip."
		(exclude_from_sim no)
		(at 30.48 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "98b019a5-5ff0-5ef7-a742-8c651073cf83")
	)
	(text "- No Wake-on-LAN (3.3 Vaux and WAKE# unused)."
		(exclude_from_sim no)
		(at 30.48 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a74915cc-db0a-5683-a4a4-4cfc5d65167e")
	)
	(text "- Powered from the slot's +3.3 V only. The 0.95 V core comes from an SY8089 buck."
		(exclude_from_sim no)
		(at 30.48 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
