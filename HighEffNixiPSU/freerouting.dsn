      (pins VIN1-1 U1-8 L1-1 Cbyp1-1 C1-1)
    )
    (net GND
      (pins U1-2 U1-4 U1-5 RSense1-2 Rfb1-2 Rfadj1-1 Rcomp1-1 J1-2 GND1-1 Cfilt1-2
        Ccomp3-1 Ccomp3-2 Ccomp1-1 Cbyp1-2 C1-2)
    )
    (net "Net-(Ccomp1-Pad2)"
      (pins Ccomp2-1 Ccomp1-2)
    )
    (net "Net-(Ccomp2-Pad2)"
      (pins Rcomp1-2 Ccomp2-2)
    )
    (net "Net-(U1-I_{SEN})"
      (pins U1-1 RFilt1-1 Cfilt1-1)
    )
    (net "unconnected-(D1-NC-Pad1)"
      (pins D1-1)
    )
    (net "Net-(D1-K)"
      (pins Rfb2-2 J1-1 D1-2)
    )
    (net "Net-(D1-A)"
      (pins Q1-2 L1-2 D1-3)
    )
    (net "Net-(U1-FA{slash}SD)"
      (pins U1-7 Rfadj1-2)
    )
    (net "Net-(Q1-S)"
      (pins RSense1-1 RFilt1-2 Q1-3)
    )
    (net "Net-(Q1-G)"
      (pins U1-6 Q1-1)
    )
    (net "Net-(U1-FB)"
      (pins U1-3 Rfb2-1 Rfb1-1)
    )
    (class kicad_default GND "Net-(C1-+)" "Net-(Ccomp1-Pad2)" "Net-(Ccomp2-Pad2)"
      "Net-(D1-A)" "Net-(D1-K)" "Net-(Q1-G)" "Net-(Q1-S)" "Net-(U1-FA{slash}SD)"
      "Net-(U1-FB)" "Net-(U1-I_{SEN})" "unconnected-(D1-NC-Pad1)"
      (circuit
        (use_via "Via[0-1]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 200)
      )
    )
  )
  (wiring
  )
)
