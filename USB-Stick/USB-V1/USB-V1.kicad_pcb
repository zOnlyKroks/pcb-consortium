				(thickness 0.043002)
			)
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(thickness 0.1)
				(material "Solder Resist")
				(epsilon_r 3.5)
				(loss_tangent 0)
			)
			(layer "B.Paste"
