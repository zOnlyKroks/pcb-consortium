			(layer "F.Cu"
				(type "copper")
				(thickness 0.043002)
			)
			(layer "dielectric 1"
				(type "prepreg")
				(thickness 1.499997)
				(material "FR-4")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
