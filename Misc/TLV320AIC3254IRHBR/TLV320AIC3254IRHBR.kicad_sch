		(uuid "404220ed-de6d-4b06-b5fa-e8a9c6bfab4d")
	)
	(text "Amp: BD mode, 400 kHz (AM=000), master, 26 dB (20k/100k), PLIMIT = GVDD (none), SDZ pulled to 24 V, ESP32 pulls it low through Q (AMP_SD high = shutdown)"
