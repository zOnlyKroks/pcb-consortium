	(text "PD: CH224K requests 9 V (R115 6.8k on CFG1), datasheet CH224K reference circuit (R113 1k VDD, R114 10k VBUS sense)."
		(exclude_from_sim no)
		(at 233.68 74.93 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "0bb2efdc-79f8-415f-84d5-ddf518338ed4")
	)
	(text "HV_OFF high (R112 pull-up, also while the ESP32 boots) drives FA/SD > 1.35 V through D104: controller off."
		(exclude_from_sim no)
		(at 233.68 95.25 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "1b58da0f-310a-4b89-aef7-a1f5c8429e58")
	)
	(text "Notes"
		(exclude_from_sim no)
		(at 233.68 69.85 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.356)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5989efb4-d8d9-4fb7-b26e-acccd6bee3b7")
	)
	(text "HV = 1.26 V x (1 + 2 MOhm / 13.7 kOhm) = 185 V.  IN-16 strikes at <= 170 V, burns at about 150 V."
		(exclude_from_sim no)
		(at 233.68 85.09 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "74d16d22-1eb3-4633-b7fa-75ccf495d7a0")
	)
	(text "    Any USB PD charger >= 18 W works. A plain 5 V port powers and flashes the ESP32; the tubes stay dark."
		(exclude_from_sim no)
		(at 233.68 80.01 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "93b772de-6ae0-473f-9603-736df6bc194c")
	)
	(text "USB-C: power (USB PD 9 V via CH224K) and ESP32 flashing on one port; 3.3 V LDO"
		(exclude_from_sim no)
		(at 25.4 31.75 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "96151be6-e4da-4d27-bd71-e22b34408c6f")
	)
	(text "WARNING: 185 V DC on the tube side.  C106 holds charge for ~5 s after power-off (2 MOhm divider bleeds it)."
		(exclude_from_sim no)
		(at 233.68 105.41 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "97806c9d-4876-46db-8c88-78a55e8b5834")
	)
	(text "J102: internal 9 V input (7-12 V), not for users"
		(exclude_from_sim no)
		(at 119.38 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9b272365-7a71-44df-a93f-75da3e756bd6")
	)
	(text "HV boost VIN (9 V) -> 185 V: LM3478 current mode, ~110 kHz, DCM"
		(exclude_from_sim no)
		(at 25.4 123.19 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b726144d-a173-4f45-beda-267e17056629")
	)
	(text "Q101 HSU5N25 250 V / 1.2 Ohm (Vth 3 V), D103 ES1J 600 V, C106 250 V.  Keep HV copper >= 0.5 mm from other nets."
		(exclude_from_sim no)
		(at 233.68 100.33 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "b9a5bc02-57ef-4a76-8aa2-e5224f92d64e")
	)
	(text "VIN monitor (IO1): 9 V -> 1.62 V"
		(exclude_from_sim no)
		(at 233.68 114.046 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.305)
