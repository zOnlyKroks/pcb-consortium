		)
		(uuid "c95bef2e-685a-42e5-b97b-6360cdd46e9e")
	)
	(text "VBUS is 9 V once the CH224K has negotiated PD (PD_OK_N low), else 5 V: the firmware only starts the HV on 9 V."
		(exclude_from_sim no)
		(at 25.4 113.03 0)
		(effects
