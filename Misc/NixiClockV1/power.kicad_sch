				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e0563c7e-ec88-4576-b672-96525a486a89")
	)
	(text "LM3478: R105 200k -> 110 kHz.  Current limit 156 mV / 0.1 Ohm = 1.56 A (L101 Isat 2.3 A), gate drive 7.2 V."
