		(uuid "006078c8-1341-5f95-9f03-98477cd79b39")
	)
	(text "Drive (per 1/6 time slot: one anode on, the digit + optional comma cathodes on)"
		(exclude_from_sim no)
		(at 243.84 205.74 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.305)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "431fdbc4-adc5-5c1f-9b57-6b399a969685")
	)
	(text "Pin 5 / pin 10 commas are DPL / DPR (left / right seen from the front, anode lead at the back)."
		(exclude_from_sim no)
		(at 243.84 223.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4dcbc85f-93bc-52c2-8998-e45b66c8997f")
	)
	(text "6 x IN-16, multiplexed 1:6: anode switches per tube, constant-current cathode sinks on 12 shared buses"
		(exclude_from_sim no)
		(at 20.32 30.48 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "7fcd2a21-754e-56cc-8e19-e91cbc19dc4b")
	)
	(text "Firmware blanks all bits ~150 us between slots (anti-ghosting); slot ~2 ms -> 83 Hz refresh."
		(exclude_from_sim no)
		(at 243.84 219.075 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bdf863ed-0c48-5d8e-a84d-3b43d9736891")
	)
	(text "Anode switch: MMBTA42 sinks 0.27 mA (10k) out of the MMBTA92 base -> saturated high side, 100k turns it off."
		(exclude_from_sim no)
		(at 243.84 214.63 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "be0912b8-1921-554f-b34e-645c94dfe44a")
	)
	(text "Cathode sink: Ie = (3.3 V - 0.65 V) / Re -> 3.9 mA digit (680R), 1.2 mA comma (2k2); 1.2 mA / 0.2 mA mean."
		(exclude_from_sim no)
		(at 243.84 210.185 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cde8eb6d-0240-534b-afc3-689d2ab09b15")
	)
