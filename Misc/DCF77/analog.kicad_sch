		(uuid "27e56adf-5034-4720-b347-33bfb3020c49")
	)
	(text "Calibration tone: MCU PWM through 10k/22R divider and 2.2p into the tank."
		(exclude_from_sim no)
		(at 127 226.06 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "309c6c28-a790-47cc-a7e7-9660d38b8639")
	)
	(text ".param dac_code=2048 sel=6\n* supplies and MCU stand-ins (MCU and power sheets are excluded from the simulation)\nVdda +3V3A 0 3.3\nVd33 +3V3 0 3.3\nVsel0 /Analog/CAP_SEL0 0 {3.3*(sel-2*floor(sel/2))}\nVsel1 /Analog/CAP_SEL1 0 {3.3*(floor(sel/2)-2*floor(sel/4))}\nVsel2 /Analog/CAP_SEL2 0 {3.3*(floor(sel/4)-2*floor(sel/8))}\nVsel3 /Analog/CAP_SEL3 0 {3.3*floor(sel/8)}\nVtone /Analog/TONE 0 0\n.ac dec 400 60k 100k"
		(exclude_from_sim no)
		(at 250 40 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "99155c00-4665-4c49-bb93-7dba650fcd26")
	)
	(text "Fine tuning: 1SV281 varactor, biased by MCP4725 through 100k/1u + 10M."
		(exclude_from_sim no)
		(at 127 82.55 0)
		(effects
