# LFE5U-25F-7BG256I emulation board - generated by tools/gen_lpf.py from tools/design.py
# All banks VCCIO = 3.3 V.  Port names: gpio[0..33], led[0..7], sw[0..7], ram_dq[0..15], ...

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 SLAVE_SPI_PORT=DISABLE MASTER_SPI_PORT=ENABLE SLAVE_PARALLEL_PORT=DISABLE;

# ---- Clock
LOCATE COMP "clk25" SITE "P6";
IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;

